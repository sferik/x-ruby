# Signatures of the public API of x-streaming, which the gem ships; sig/internal declares its internals for Steep alone
module X
  module Streaming
    VERSION: String

    def self.gem_version: () -> Gem::Version

    class Error < X::Error
    end

    # The streaming method mixed into a client
    module API
      def streaming: (?read_timeout: Numeric?, ?max_reconnects: Float | Integer, ?on_reconnect: StreamingClient::_ReconnectHook?) -> StreamingClient
    end
  end

  class RulesRejected < Streaming::Error
    attr_reader problems: Array[Problem]
    attr_reader added: Array[StreamRule]?
    attr_reader deleted_count: Integer?

    def initialize: (?String? message, ?problems: Array[Problem], ?added: Array[StreamRule]?, ?deleted_count: Integer?) -> void
  end

  class StreamError < Streaming::Error
    attr_reader problems: Array[Problem]
    attr_reader http_method: Symbol?
    attr_reader uri: URI::Generic?

    def initialize: (?String? message, ?problems: Array[Problem], ?http_method: (Symbol | String)?, ?uri: URI::Generic?) -> void
  end

  class StreamRule
    attr_reader id: Integer?
    attr_reader value: String
    attr_reader tag: String?
    def initialize: (value: String, ?tag: String?, ?id: (Integer | String)?) -> void
    def to_h: () -> {id: Integer?, value: String, tag: String?}
    def deconstruct_keys: (Array[Symbol]? _keys) -> {id: Integer?, value: String, tag: String?}
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def inspect: () -> String
    def marshal_dump: () -> untyped
    def marshal_load: (untyped state) -> void
    def encode_with: (untyped coder) -> void
    def init_with: (untyped coder) -> void
  end

  class StreamingClient
    DEFAULT_READ_TIMEOUT: Float | Integer
    DEFAULT_MAX_RECONNECTS: Float | Integer

    type addable_rule = StreamRule | Hash[untyped, untyped] | String
    type rule = addable_rule | Integer

    # The callable passed the error that dropped a stream and its wait to reconnect, before each wait
    interface _ReconnectHook
      def call: (StandardError error, Integer | Float wait) -> untyped
    end

    attr_reader client: Client
    attr_reader on_reconnect: _ReconnectHook?
    def initialize: (Client client, ?read_timeout: Numeric?, ?max_reconnects: Integer | Float, ?on_reconnect: _ReconnectHook?) -> void
    def inspect: () -> String
    def stream: (String endpoint, ?params: params?, ?headers: headers, ?array_class: Class, ?object_class: object_class) { (untyped) -> void } -> untyped
    def stop: () -> nil
    def stopped?: () -> bool
    def read_timeout: () -> Numeric?
    def max_reconnects: () -> (Integer | Float)
    def rules: (?params: params?) -> Array[StreamRule]
    def add_rules: (Array[addable_rule] | addable_rule rules, ?dry_run: bool) ?{ (Problem problem) -> void } -> Array[StreamRule]
    def delete_rules: (Array[rule] | rule rules, ?dry_run: bool) ?{ (Problem problem) -> void } -> Integer
    def marshal_dump: () -> bot
    def encode_with: (untyped coder) -> bot
    def as_json: (*untyped) -> bot
    def to_json: (?JSON::State? state) -> bot
  end
end
