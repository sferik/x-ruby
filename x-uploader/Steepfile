# frozen_string_literal: true

# Type checks x-uploader against the signatures that x-core ships, and the internals of x-core, whose
# X::Core::RetryHandler it retries the requests of an upload with
target :lib do
  signature "sig"
  signature "../x-core/sig/x-core.rbs"
  signature "../x-core/sig/internal"
  check "lib"
  library "forwardable"
  library "json"
  library "monitor"
  library "net-http"
  library "openssl"
  library "securerandom"
  library "simple_oauth"
  library "tmpdir"
  library "uri"
  library "zlib"
  configure_code_diagnostics(Steep::Diagnostic::Ruby.strict)
end
