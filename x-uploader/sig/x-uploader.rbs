module X
  module Uploader
    VERSION: String
    JSON_CLASSES: Hash[Symbol, singleton(Array) | singleton(Hash)]

    def self.gem_version: () -> Gem::Version

    # Media to act on: what an upload returned, or the identifier of media
    type media = UploadedMedia | Hash[String, untyped] | String | Integer

    # Media to upload: a path to it, an IO open on it, or the source it has been resolved to
    type uploadable = path | _Reader | Source

    class Source
      SNIFF_BYTES: Integer

      def self.for: (uploadable media) -> Source
      def self.named_or_read: (untyped media) -> Source
      def self.buffered: (untyped media) -> Buffer
      def self.position_of: (untyped media) -> Integer?

      attr_reader name: String?
      def named?: () -> bool
      def description: () -> String
      def extension: () -> String
      def sniff: () -> String
      def exist?: () -> bool
      def readable?: () -> bool
      def size: () -> Integer
      def content: () -> String
      def read: (Integer length, Integer offset) -> String

      class Path < Source
        def initialize: (path path) -> void
        def name: () -> String
      end

      class Handle < Source
        @io: untyped
        @mutex: Thread::Mutex

        def initialize: (untyped io) -> void
      end

      class Buffer < Source
        @content: String

        def initialize: (String content) -> void
      end
    end

    module Signature
      MP4_BRANDS: Array[String]
      SIGNATURES: Hash[Hash[Integer, String], String]
      CATEGORIES: Hash[String, String]
      DEFAULT_CATEGORY: String
      extend Signature

      def media_type: (String bytes) -> String?
      def media_type!: (Source source) -> String
      def media_category!: (Source source) -> String
      def media_category: (Source source) -> String

      private
      def matches?: (String bytes, Hash[Integer, String] magic) -> bool
    end

    # What the uploaders ask of a client, which X::Client provides
    interface _Client
      def get: (String endpoint, **untyped) -> untyped
      def post: (String endpoint, ?untyped body, **untyped) -> untyped
    end

    module API : _Client
      def upload_media: (uploadable media, **untyped options) -> UploadedMedia?
      def await_media_processing: (media media, **untyped options) -> UploadedMedia?
      def await_media_processing!: (media media, **untyped options) -> UploadedMedia?
      def add_alt_text: (media media, String text) -> Hash[String, untyped]?
      def add_subtitles: (media video, media subtitles, String language_code, **untyped options) -> Hash[String, untyped]?
      def update_profile_image: (path file_path) -> Hash[String, untyped]?
      def update_profile_banner: (path file_path, **untyped options) -> Hash[String, untyped]?
    end

    class Error < ::X::Error
    end

    module Utils
      extend Utils

      SUBTITLED_MEDIA_CATEGORIES: Hash[String, String]
      NO_MEDIA_ID: String
      NO_MEDIA: String

      def extension: (path file_path) -> String
      def media_id: (media media) -> String
      def media_data: (Hash[String, untyped]? response, String description) -> Hash[String, untyped]?
      def subtitled_media_category: (String | Symbol media_category) -> String
    end

    module Multipart
      extend Multipart

      def headers: (String boundary) -> Hash[String, String]
      def body: (String name, String content, boundary: String, **untyped fields) -> String
    end

    module Chunks
      NO_MEDIA: String
      extend Chunks

      def init: (client: _Client, source: Source, media_type: String, media_category: String) -> Hash[String, untyped]
      def append: (client: _Client, source: Source, chunk_size: Integer, media: untyped, boundary: String, concurrency: Integer) -> void

      private
      def await: (Array[Thread] workers) -> void
      def chunk_queue: (Source source, Integer chunk_size) -> Thread::Queue
      def append_worker: (Thread::Queue queue, Thread::Queue errors, client: _Client, source: Source, chunk_size: Integer, media_id: String, boundary: String) -> Thread
      def upload_chunk: (client: _Client, media_id: String, upload_body: String, headers: Hash[String, String]) -> untyped
      def max_retries_of: (_Client client) -> Integer
    end

    module MediaUpload
      BYTES_PER_MB: Integer
      AMPLIFY_VIDEO: String
      DM_GIF: String
      DM_IMAGE: String
      DM_VIDEO: String
      SUBTITLES: String
      TWEET_GIF: String
      TWEET_IMAGE: String
      TWEET_VIDEO: String
      MIME_TYPES: Array[String]
      BMP_MIME_TYPE: String
      GIF_MIME_TYPE: String
      JPEG_MIME_TYPE: String
      PJPEG_MIME_TYPE: String
      PNG_MIME_TYPE: String
      TIFF_MIME_TYPE: String
      WEBP_MIME_TYPE: String
      GLTF_BINARY_MIME_TYPE: String
      USDZ_MIME_TYPE: String
      SUBRIP_MIME_TYPE: String
      WEBVTT_MIME_TYPE: String
      MPEG_TS_MIME_TYPE: String
      MP4_MIME_TYPE: String
      QUICKTIME_MIME_TYPE: String
      WEBM_MIME_TYPE: String
      MIME_TYPE_MAP: Hash[String, String]
      VIDEO_MIME_TYPES: Array[String]
      SUBTITLES_MIME_TYPES: Array[String]
      DEFAULT_PROCESSING_TIMEOUT: Integer
      DEFAULT_CONCURRENCY: Integer
      MAX_SIMPLE_UPLOAD_BYTES: Integer
      MIN_CHECK_AFTER_SECS: Integer
      STATUS_COMMAND: String
      VIDEO_CATEGORIES: Array[String]
      CHUNKED_CATEGORIES: Array[String]
      GIF_CATEGORIES: Array[String]
      CATEGORY_MAP: Hash[String, String]
      CATEGORY_MIME_TYPES: Hash[String, Array[String]]
      extend MediaUpload

      def upload: (uploadable media, client: _Client, ?media_category: (String | Symbol)?, ?alt_text: String?, ?processing_timeout: Float | Integer, ?media_type: String?, ?chunk_size_mb: (Float | Integer)?, ?concurrency: Integer) -> UploadedMedia?
      def chunked_upload?: (uploadable media, String | Symbol media_category) -> bool
      def infer_media_category: (uploadable media) -> String
      def upload_binary: (String content, client: _Client, media_category: String | Symbol) -> UploadedMedia?
      def chunked_upload: (uploadable media, client: _Client, ?media_category: (String | Symbol)?, ?media_type: String?, ?chunk_size_mb: (Float | Integer)?, ?concurrency: Integer) -> UploadedMedia?
      def await_processing: (media media, client: _Client, ?processing_timeout: Float | Integer) -> UploadedMedia?
      def await_processing!: (media media, client: _Client, ?processing_timeout: Float | Integer) -> UploadedMedia?
      def infer_media_type: (uploadable media, String | Symbol media_category) -> String
    end

    module Gif
      HEADER_SIZE: Integer
      EXTENSION_INTRODUCER: Integer
      IMAGE_SEPARATOR: Integer
      IMAGE_DESCRIPTOR_SIZE: Integer
      extend Gif

      def animated?: (uploadable media) -> bool

      private
      def after_block: (String data, Integer position, Integer block) -> Integer
      def skip_color_table: (Integer position, Integer flags) -> Integer
      def skip_sub_blocks: (String data, Integer position) -> Integer
    end

    module Metadata
      SUBTITLED_MEDIA_CATEGORY: String
      NO_METADATA: String
      extend Metadata

      def add_alt_text: (media media, String text, client: _Client) -> Hash[String, untyped]?
      def add_subtitles: (media video, media subtitles, String language_code, client: _Client, ?display_name: String?, ?media_category: String | Symbol) -> Hash[String, untyped]?
    end

    module Validator
      BYTES_PER_MB: Integer
      MAX_ALT_TEXT_LENGTH: Integer
      MAX_SEGMENTS: Integer
      MEDIA_CATEGORIES: Array[String]
      extend Validator

      def validate_upload!: (Source source, String | Symbol media_category, alt_text: String?, chunk_size_mb: (Float | Integer)?, concurrency: Integer, processing_timeout: Float | Integer) -> String
      def validate_source!: (Source source) -> nil
      def validate_file_path!: (path file_path) -> nil
      def validate_extension!: (path file_path, Array[String] extensions) -> nil
      def validate_alt_text!: (String? alt_text) -> nil
      def validate_media_category!: (String | Symbol media_category) -> String
      def validate_chunks!: (chunk_size_mb: (Float | Integer)?, concurrency: Integer) -> nil
      def validate_processing_timeout!: (untyped processing_timeout) -> nil
      def validate_segments!: (Source source, (Float | Integer)? chunk_size_mb) -> Integer
    end

    module Account
      V1_BASE_URL: String
      PROFILE_IMAGE_URL: String
      PROFILE_BANNER_URL: String
      SUPPORTED_EXTENSIONS: Array[String]
      extend Account

      def update_profile_image: (path file_path, client: _Client) -> Hash[String, untyped]?
      def update_profile_image_binary: (String content, client: _Client) -> Hash[String, untyped]?
      def update_profile_banner: (path file_path, client: _Client, ?width: Integer?, ?height: Integer?, ?offset_left: Integer?, ?offset_top: Integer?) -> Hash[String, untyped]?
      def update_profile_banner_binary: (String content, client: _Client, ?width: Integer?, ?height: Integer?, ?offset_left: Integer?, ?offset_top: Integer?) -> Hash[String, untyped]?
    end
  end

  class UploadedMedia
    FINAL_STATES: Array[String]
    NO_MEDIA_ID: String

    @received_at: Time

    attr_reader attrs: Hash[String, untyped]
    alias to_h attrs

    def self.from: (Hash[String, untyped]? attrs) -> UploadedMedia?
    def initialize: (Hash[String, untyped] attrs) -> void
    def id: () -> Integer
    def media_key: () -> String?
    def bytesize: () -> Integer?
    def expires_at: () -> Time?
    def processing_info: () -> Hash[String, untyped]?
    def state: () -> String?
    def check_after_secs: () -> Integer?
    def processing?: () -> bool
    def failed?: () -> bool
    def ready?: () -> bool
    def []: (String key) -> untyped
    def fetch: (String key, *untyped default) ?{ (String key) -> untyped } -> untyped
    def dig: (*String | Integer keys) -> untyped
    def key?: (String key) -> bool
    def as_json: (*untyped) -> Hash[String, untyped]
    def to_json: (?::JSON::State? state) -> String
    def ==: (untyped other) -> bool
    alias eql? ==
    def hash: () -> Integer
    def inspect: () -> String

    private
    def with_integer_id: (Hash[String, untyped] attrs) -> Hash[String, untyped]
    def deep_freeze: (untyped value) -> untyped
  end

  class InvalidMediaType < Uploader::Error
  end

  class MissingData < Uploader::Error
  end

  class MediaProcessingTimeout < Uploader::Error
    attr_reader status: UploadedMedia | Hash[String, untyped] | nil
    attr_reader timeout: (Float | Integer)?
    def initialize: (?String? message, ?status: UploadedMedia | Hash[String, untyped] | nil, ?timeout: (Float | Integer)?) -> void
  end

  class MediaProcessingFailed < Uploader::Error
    DEFAULT_MESSAGE: String

    attr_reader status: UploadedMedia | Hash[String, untyped] | nil
    def initialize: (?String? message, ?status: UploadedMedia | Hash[String, untyped] | nil) -> void
  end
end
