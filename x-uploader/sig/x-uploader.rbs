module X
  module Uploader
    VERSION: String

    def self.gem_version: () -> Gem::Version

    # Media that has a media key, which names its media identifier, such as the X::Media of x-objects
    interface _MediaKeyed
      def media_key: () -> String?
    end

    # Media to act on: what an upload returned, media that has a media key, or the identifier of media
    type media = UploadedMedia | Hash[String, untyped] | _MediaKeyed | String | Integer

    # Media to upload: a path to it, or an IO open on it
    type uploadable = path | _Reader

    # What the uploaders ask of a client, which X::Client provides
    interface _Client
      def get: (String endpoint, **untyped) -> untyped
      def post: (String endpoint, ?untyped body, **untyped) -> untyped
    end

    module API : _Client
      def upload_media: (uploadable media, **untyped options) -> UploadedMedia
      def await_media_processing: (media media, **untyped options) -> UploadedMedia
      def await_media_processing!: (media media, **untyped options) -> UploadedMedia
      def add_alt_text: (media media, String text) -> UploadedMedia
      def add_subtitles: (media video, media subtitles, String language_code, **untyped options) -> UploadedMedia
      def update_profile_image: (uploadable media) -> Hash[String, untyped]?
      def update_profile_banner: (uploadable media, **untyped options) -> nil
    end

    class Error < ::X::Error
    end

    module MediaUpload
      AMPLIFY_VIDEO: String
      DM_GIF: String
      DM_IMAGE: String
      DM_VIDEO: String
      SUBTITLES: String
      TWEET_GIF: String
      TWEET_IMAGE: String
      TWEET_VIDEO: String
      DEFAULT_PROCESSING_TIMEOUT: Integer
      DEFAULT_CONCURRENCY: Integer
      MAX_CONCURRENCY: Integer
      extend MediaUpload

      def upload: (uploadable media, client: _Client, ?media_category: (String | Symbol)?, ?alt_text: String?, ?processing_timeout: Float | Integer, ?media_type: String?, ?chunk_size_mb: (Float | Integer)?, ?concurrency: Integer) -> UploadedMedia
      def upload_binary: (String content, client: _Client, media_category: String | Symbol) -> UploadedMedia
      def chunked_upload: (uploadable media, client: _Client, ?media_category: (String | Symbol)?, ?media_type: String?, ?chunk_size_mb: (Float | Integer)?, ?concurrency: Integer) -> UploadedMedia
      def await_processing: (media media, client: _Client, ?processing_timeout: Float | Integer) -> UploadedMedia
      def await_processing!: (media media, client: _Client, ?processing_timeout: Float | Integer) -> UploadedMedia
    end

    module Metadata
      extend Metadata

      def add_alt_text: (media media, String text, client: _Client) -> UploadedMedia
      def add_subtitles: (media video, media subtitles, String language_code, client: _Client, ?display_name: String?, ?media_category: String | Symbol) -> UploadedMedia
    end

    module Account
      extend Account

      def update_profile_image: (uploadable media, client: _Client) -> Hash[String, untyped]?
      def update_profile_image_binary: (String content, client: _Client) -> Hash[String, untyped]?
      def update_profile_banner: (uploadable media, client: _Client, ?width: Integer?, ?height: Integer?, ?offset_left: Integer?, ?offset_top: Integer?) -> nil
      def update_profile_banner_binary: (String content, client: _Client, ?width: Integer?, ?height: Integer?, ?offset_left: Integer?, ?offset_top: Integer?) -> nil
    end
  end

  class UploadedMedia
    attr_reader attrs: Hash[String, untyped]
    alias to_h attrs

    def self.from: (Hash[String, untyped]? attrs) -> UploadedMedia?
    def initialize: (Hash[String, untyped] attrs) -> void
    def id: () -> Integer
    def media_id: () -> Integer
    def media_key: () -> String?
    def bytesize: () -> Integer?
    def expires_after_secs: () -> Integer?
    def processing_info: () -> Hash[String, untyped]?
    def state: () -> String?
    def check_after_secs: () -> Integer?
    def processing?: () -> bool
    def failed?: () -> bool
    def ready?: () -> bool
    def []: (String key) -> untyped
    def fetch: (String key, *untyped default) ?{ (String key) -> untyped } -> untyped
    def dig: (*String | Integer keys) -> untyped
    def key?: (String key) -> bool
    def as_json: (*untyped) -> Hash[String, untyped]
    def to_json: (?::JSON::State? state) -> String
    def ==: (untyped other) -> bool
    alias eql? ==
    def hash: () -> Integer
    def inspect: () -> String
  end

  class InvalidMediaType < Uploader::Error
  end

  class MissingMediaData < Uploader::Error
  end

  class MediaProcessingTimeout < Uploader::Error
    attr_reader status: UploadedMedia | Hash[String, untyped] | nil
    attr_reader timeout: (Float | Integer)?
    def initialize: (?String? message, ?status: UploadedMedia | Hash[String, untyped] | nil, ?timeout: (Float | Integer)?) -> void
  end

  class AltTextFailed < Uploader::Error
    attr_reader media: UploadedMedia?
    def initialize: (?String? message, ?media: UploadedMedia?) -> void
    def to_s: () -> String
  end

  class MediaProcessingFailed < Uploader::Error
    attr_reader status: UploadedMedia | Hash[String, untyped] | nil
    def initialize: (?String? message, ?status: UploadedMedia | Hash[String, untyped] | nil) -> void
  end
end
