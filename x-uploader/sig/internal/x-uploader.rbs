# The internals of x-uploader: the modules, classes, constants, and methods the code keeps private, which Steep type
# checks it against, but which the gem does not ship, since the gemspec packages sig/*.rbs alone. Code that depends
# on x-uploader is checked against sig/x-uploader.rbs, which declares its public interface, so that it cannot refer
# to what the code hides, and these can change within 1.x.
module X
  module Uploader
    JSON_CLASSES: Hash[Symbol, singleton(Array) | singleton(Hash)]

    # Media to upload, or the Source an upload has resolved it to, which the internals of the uploaders pass on
    type resolvable = uploadable | Source

    class Source
      SNIFF_BYTES: Integer
      CONTENT_BYTES: Regexp
      NOT_A_PATH: String
      STREAM_PATHS: Array[String]

      def self.for: (resolvable media) -> Source
      def self.named_or_read: (untyped media) -> Source
      def self.path_alone?: (untyped media) -> bool
      def self.on_file?: (untyped media) -> bool
      def self.buffered: (untyped media) -> Buffer
      def self.read_whole: (untyped media, Integer? position) -> String
      def self.position_of: (untyped media) -> Integer?

      attr_reader name: String?
      def description: () -> String
      def extension: () -> String
      def sniff: () -> String
      def exist?: () -> bool
      def readable?: () -> bool
      def size: () -> Integer
      def content: () -> String
      def read: (Integer length, Integer offset) -> String

      class Path < Source
        @size: Integer?

        def initialize: (path path) -> void
        def name: () -> String
      end

      class Handle < Source
        @io: untyped
        @mutex: Thread::Mutex
        @size: Integer?

        def initialize: (untyped io) -> void

        private
        def seek_and_read: (Integer length, Integer offset) -> String
        def open_for_reading?: () -> bool
      end

      class Buffer < Source
        @content: String

        def initialize: (String content) -> void
      end
    end

    module Signature
      MP4_BRANDS: Array[String]
      SIGNATURES: Hash[Hash[Integer, String], String]
      EBML: String
      WEBM_DOC_TYPE: String
      extend Signature

      def media_type: (String bytes) -> String?
      def matroska?: (String bytes) -> bool

      private
      def matroska_type: (String bytes) -> String?
      def matches?: (String bytes, Hash[Integer, String] magic) -> bool
    end

    module Utils
      extend Utils

      SUBTITLED_MEDIA_CATEGORIES: Hash[String, String]
      NO_MEDIA_ID: String
      NO_MEDIA: String
      NO_METADATA: String
      NOT_MEDIA: String
      NOT_MEDIA_KEY: String
      MIN_CHECK_AFTER_SECS: Integer
      UNKNOWN_STATE: String
      MEDIA_KEY: Regexp
      MEDIA_ID: Regexp
      NOT_MEDIA_ID: String

      def extension: (path file_path) -> String
      def without_client: (Hash[Symbol, untyped] options) -> Hash[Symbol, untyped]
      def media_id: (media media) -> String
      def media_key_id: (untyped media) -> String?
      def uploaded_media: (media media) -> UploadedMedia
      def described: (Hash[String, untyped]? response, media media) -> UploadedMedia
      def media_data: (Hash[String, untyped]? response, String description) -> Hash[String, untyped]
      def single_request: (::X::Client client, String content, String media_category, additional_owners: Array[Integer | String]?) -> UploadedMedia
      def identified?: (Hash[String, untyped] media) -> bool
      def subtitled_media_category: (String | Symbol media_category) -> String
      def sending_again: [T] (::X::Client client) { () -> T } -> T
      def processed!: (UploadedMedia status) -> UploadedMedia
      def seconds_from_now: (Numeric seconds) -> Float
      def wait_to_check: (UploadedMedia status, deadline: Float, timeout: Numeric) -> void
    end

    module Multipart
      extend Multipart

      def headers: (String boundary) -> Hash[String, String]
      def post: (::X::Client client, String url, String name, String content, **untyped fields) -> Hash[String, untyped]?
      def body: (String name, String content, boundary: String, **untyped fields) -> String
    end

    module Chunks
      NO_MEDIA: String
      CHANGED: String
      extend Chunks

      def upload: (client: ::X::Client, source: Source, media_type: String, media_category: String, chunk_size: Integer?, concurrency: Integer, shared: bool?, additional_owners: Array[Integer | String]?) -> UploadedMedia
      def init: (client: ::X::Client, source: Source, media_type: String, media_category: String, ?shared: bool?, ?additional_owners: Array[Integer | String]?) -> Hash[String, untyped]
      def append: (client: ::X::Client, source: Source, chunk_size: Integer, media: untyped, boundary: String, concurrency: Integer) -> void
      def finalize: (client: ::X::Client, media: Hash[String, untyped]) -> Hash[String, untyped]?
      def complete: (client: ::X::Client, source: Source, chunk_size: Integer, media: Hash[String, untyped], concurrency: Integer) -> UploadedMedia

      private
      def await: (Array[Thread] workers) -> void
      def chunk_queue: (Source source, Integer chunk_size) -> Thread::Queue
      def append_worker: (Thread::Queue queue, Thread::Queue errors, client: ::X::Client, source: Source, chunk_size: Integer, media_id: String, boundary: String) -> Thread
      def chunk: (Source source, Integer chunk_size, Integer index, Integer offset) -> String
      def upload_chunk: (client: ::X::Client, media_id: String, upload_body: String, headers: Hash[String, String]) -> untyped
    end

    module MediaUpload
      BYTES_PER_MB: Integer
      MAX_SIMPLE_UPLOAD_BYTES: Integer
      MIME_TYPES: Array[String]
      BMP_MIME_TYPE: String
      GIF_MIME_TYPE: String
      JPEG_MIME_TYPE: String
      PJPEG_MIME_TYPE: String
      PNG_MIME_TYPE: String
      TIFF_MIME_TYPE: String
      WEBP_MIME_TYPE: String
      SUBRIP_MIME_TYPE: String
      WEBVTT_MIME_TYPE: String
      MPEG_TS_MIME_TYPE: String
      MP4_MIME_TYPE: String
      QUICKTIME_MIME_TYPE: String
      WEBM_MIME_TYPE: String
      MIME_TYPE_MAP: Hash[String, String]
      IMAGE_MIME_TYPES: Array[String]
      VIDEO_MIME_TYPES: Array[String]
      SUBTITLES_MIME_TYPES: Array[String]
      SIGNED_MIME_TYPES: Array[String]
      STATUS_COMMAND: String
      VIDEO_CATEGORIES: Array[String]
      CHUNKED_CATEGORIES: Array[String]
      GIF_CATEGORIES: Array[String]
      IMAGE_CATEGORIES: Array[String]
      MAX_GIF_BYTES: Integer
      TYPE_CATEGORIES: Hash[String, String]
      UNDOCUMENTED_VIDEOS: Hash[String, String]
      UNDOCUMENTED_MODELS: Hash[String, String]
      CATEGORY_MIME_TYPES: Hash[String, Array[String]]

      module Inference
        extend Inference

        def chunked_upload?: (resolvable media, String | Symbol media_category) -> bool
        def infer_media_category: (resolvable media) -> String
        def infer_media_type: (resolvable media, String | Symbol media_category) -> String
        def single_request!: (Source source, String media_category) -> String
        def taken_type: (Source source, String media_category) -> String?
        def media_type_of: (Source source) -> String?
        def documented!: (Source source) -> void
        def matroska?: (Source source) -> bool
      end
    end

    module Gif
      HEADER_SIZE: Integer
      EXTENSION_INTRODUCER: Integer
      IMAGE_SEPARATOR: Integer
      IMAGE_DESCRIPTOR_SIZE: Integer
      extend Gif

      def animated?: (resolvable media) -> bool

      private
      def after_block: (String data, Integer position, Integer block) -> Integer
      def skip_color_table: (Integer position, Integer flags) -> Integer
      def skip_sub_blocks: (String data, Integer position) -> Integer
    end

    module Metadata
      SUBTITLED_MEDIA_CATEGORY: String
    end

    module Validator
      BYTES_PER_MB: Integer
      MAX_ALT_TEXT_LENGTH: Integer
      LANGUAGE_CODE: Regexp
      USER_ID: Regexp
      MAX_SEGMENTS: Integer
      MAX_CHUNK: Integer
      MAX_CONCURRENCY: Integer
      MEDIA_CATEGORIES: Array[String]
      MAX_MEDIA_BYTES: Hash[String, Integer]
      MAX_UPLOAD_BYTES: Integer
      PROFILE_IMAGE_TYPES: Array[String]
      BANNER_REGION: Hash[Symbol, Integer]
      MAX_PROFILE_IMAGE_BYTES: Integer
      MAX_PROFILE_BANNER_BYTES: Integer
      MAX_SIMPLE_UPLOAD_BYTES: Integer
      extend Validator

      def validate_upload!: (Source source, (String | Symbol)? media_category, alt_text: String?, chunk_size: Integer?, concurrency: Integer, processing_timeout: Numeric, ?shared: untyped, ?additional_owners: untyped) ?{ () -> (String | Symbol) } -> String
      def validate_source!: (Source source) -> nil
      def validate_sharing!: (untyped shared, untyped additional_owners) -> void
      def user_id?: (untyped value) -> bool
      def validate_alt_text!: (String? alt_text) -> nil
      def utf8?: (String text) -> bool
      def validate_language_code!: (untyped language_code) -> String
      def validate_media_category!: (String | Symbol media_category) -> String
      def validate_chunks!: (chunk_size: Integer?, concurrency: Integer) -> nil
      def whole_number?: (untyped value, Integer least) -> bool
      def validate_banner_region!: (**untyped region) -> void
      def validate_processing_timeout!: (untyped processing_timeout) -> nil
      def validate_segments!: (Source source, Integer? chunk_size) -> Integer
      def validate_size!: (Source source, String media_category) -> nil
      def validate_profile_image!: (Source source, Integer max_bytes, String use) -> nil
      def derived_chunk_size: (Integer file_size) -> Integer
    end

    module Account
      V1_BASE_URL: String
      PROFILE_IMAGE_URL: String
      PROFILE_BANNER_URL: String
    end
  end

  class UploadedMedia
    PROCESSING_STATES: Array[String]
    IDENTIFYING_KEYS: Array[String]
    MEDIA_ID: Regexp
    NO_MEDIA_ID: String
    MARSHAL_FORMAT: Integer
    YAML_KEYS: Array[String]

    private
    def deep_freeze: (untyped value) -> untyped
  end

  class ChunkedUploadFailed < Uploader::Error
    private def self.keeping: [T] (Hash[String, untyped] media) { () -> T } -> T
  end

  class AltTextFailed < Uploader::Error
    private def self.keeping: [T] (UploadedMedia media) { () -> T } -> T
  end

  class MediaProcessingCheckFailed < Uploader::Error
    private def self.keeping: [T] (UploadedMedia media) { () -> T } -> T
  end

  class MediaProcessingFailed < Uploader::Error
    DEFAULT_MESSAGE: String
  end

  class MediaProcessingTimeout < Uploader::Error
    WITHIN_TIMEOUT: String
  end
end
