        def find_all_spaces: (Array[id] ids, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Space]
        def search_spaces: (String query, **untyped params) -> Cursor[Space]
        def find_all_spaces_by_creator: (Array[id] users, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Space]
      end

      module Media : _Client
        def find_media: (String | _MediaKeyHolder media_key, **untyped params) ?{ (Problem problem) -> void } -> X::Media?
        def find_all_media: (Array[String | _MediaKeyHolder] media, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[X::Media]
        def find_media!: (String | _MediaKeyHolder media_key, **untyped params) -> X::Media
      end

      module Communities : _Client
        def find_community: (id id, **untyped params) ?{ (Problem problem) -> void } -> Community?
        def find_community!: (id id, **untyped params) -> Community
        def search_communities: (String query, **untyped params) -> Cursor[Community]
      end

      module Trends : _Client
        def trends: (Integer | String woeid, **untyped params) -> Array[Trend]
        def personalized_trends: (**untyped params) -> Array[PersonalizedTrend]
      end

      module DirectMessages : _Client
        def find_direct_message: (id id, **untyped params) ?{ (Problem problem) -> void } -> DirectMessage?
        def find_dm: (id id, **untyped params) ?{ (Problem problem) -> void } -> DirectMessage?
        def find_direct_message!: (id id, **untyped params) -> DirectMessage
        def find_dm!: (id id, **untyped params) -> DirectMessage
        def direct_messages: (**untyped params) -> Cursor[DirectMessage]
        def dms: (**untyped params) -> Cursor[DirectMessage]
        def direct_messages_with: (id user, **untyped params) -> Cursor[DirectMessage]
        def dms_with: (id user, **untyped params) -> Cursor[DirectMessage]
        def direct_messages_in: (DirectMessage | String | Integer conversation, **untyped params) -> Cursor[DirectMessage]
        def dms_in: (DirectMessage | String | Integer conversation, **untyped params) -> Cursor[DirectMessage]
      end
    end

    module Actions
      module Posts : _Client
        def create_post: (?String? text, ?reply_to: Objects::id?, ?quote: Objects::id?, ?media_ids: untyped, ?community: Objects::id?, **untyped params) -> Post?
        def create_tweet: (?String? text, ?reply_to: Objects::id?, ?quote: Objects::id?, ?media_ids: untyped, ?community: Objects::id?, **untyped params) -> Post?
        def delete_post: (id post) -> bool
        def delete_tweet: (id post) -> bool
        def hide_reply: (id post) -> bool
        def unhide_reply: (id post) -> bool
      end

      module Lists : _Client, _CurrentUser
        def create_list: (String name, **untyped params) -> List?
        def update_list: (id list, **untyped params) -> bool
        def delete_list: (id list) -> bool
        def add_list_member: (id list, id user) -> bool
        def remove_list_member: (id list, id user) -> bool
        def follow_list: (id list) -> bool
        def unfollow_list: (id list) -> bool
        def pin_list: (id list) -> bool
        def unpin_list: (id list) -> bool
      end

      module DirectMessages : _Client
        def create_direct_message: (id user, ?String? text, ?media_ids: untyped, **untyped params) -> DirectMessage?
        def create_dm: (id user, ?String? text, ?media_ids: untyped, **untyped params) -> DirectMessage?
        def create_group_direct_message: (Array[id] users, ?String? text, ?media_ids: untyped, **untyped params) -> DirectMessage?
        def create_group_dm: (Array[id] users, ?String? text, ?media_ids: untyped, **untyped params) -> DirectMessage?
        def create_direct_message_in: (DirectMessage | String | Integer conversation, ?String? text, ?media_ids: untyped, **untyped params) -> DirectMessage?
        def create_dm_in: (DirectMessage | String | Integer conversation, ?String? text, ?media_ids: untyped, **untyped params) -> DirectMessage?
        def delete_direct_message: (id message) -> bool
        def delete_dm: (id message) -> bool
      end

      module Relationships : _Client, _CurrentUser
        def follow: (id user) -> bool
        def unfollow: (id user) -> bool
        def block: (id user) -> bool
        def unblock: (id user) -> bool
        def mute: (id user) -> bool
        def unmute: (id user) -> bool
      end

      module Engagement : _Client, _CurrentUser
        def like: (id post) -> bool
        def unlike: (id post) -> bool
        def repost: (id post) -> bool
        def retweet: (id post) -> bool
        def unrepost: (id post) -> bool
        def unretweet: (id post) -> bool
        def bookmark: (id post) -> bool
        def unbookmark: (id post) -> bool
      end
    end
  end

  class Trend
    MAX_TRENDS: Integer
    include Objects::ValueEquality
    include Objects::ValueMarshalling
    include Objects::Serialization

    private def self.woeid_of: (untyped woeid) -> String
  end

  class MatchingRule
    include Objects::ValueEquality
    include Objects::ValueMarshalling
    include Objects::Serialization
  end

  class PersonalizedTrend
    include Objects::ValueEquality
    include Objects::ValueMarshalling
    include Objects::Serialization

    ENDPOINT: String
  end

  class PostUsage
    include Objects::ValueEquality
    include Objects::ValueMarshalling
    include Objects::Serialization

    ENDPOINT: String

    private
    def days: (String reader, untyped entries) -> Hash[Time, Integer]
    def integer: (String reader, String | Integer | nil value) -> Integer?
    def time: (String reader, untyped value) -> Time
  end

  class Resource
    extend Objects::AbstractClass
    extend Objects::Attributes
    include Objects::PublishedCount
    include Objects::Identity
    include Objects::Serialization
    include Objects::Marshalling

    private attr_reader includes: Objects::Includes

    @hydrated: bool
    @batch: Objects::Batch?
    @memo: Objects::Memo

    private def self.endpoint: () -> String?
    private def self.id_key: () -> String
    private def self.id_type: () -> Symbol
    private def self.includes_key: () -> String?
    private def self.fields_key: () -> String?
    private def self.fully_requested_by?: (Hash[String, untyped] query) -> bool
    private def self.resource_from_response: (Objects::body body, client: Objects::_Client?, ?hydrated: bool) -> Resource?
    private def self.collection_from_response: (Objects::body body, client: Objects::_Client?, ?hydrated: bool) -> Page[Resource]
    private def self.resource_built_from: (Objects::body body, client: Objects::_Client?, hydrated: bool, query: Hash[String, untyped]?) -> Resource?
    private def self.collection_built_from: (Objects::body body, client: Objects::_Client?, hydrated: bool, query: Hash[String, untyped]?) -> Array[Resource]
    private def self.batch_key: () -> Symbol
    private def self.endpoint!: () -> String
    private def self.from_id_in_batch: (Objects::id id, client: Objects::_Client?, ?batch: Objects::Batch?) -> Resource
    private def self.build: (Hash[untyped, untyped] attrs, ?client: Objects::_Client?, ?includes: Objects::Includes, ?hydrated: bool, ?batch: Objects::Batch?) -> instance
    private def self.built: (Hash[untyped, untyped] attrs, client: Objects::_Client?, includes: Objects::Includes, hydrated: bool) -> Resource

    private
    def hydrated_with: (Resource? resource) -> Resource?
    def hydration_stored?: () -> bool
    def setup: (Hash[untyped, untyped] attrs, client: Objects::_Client?, hydrated: bool, ?includes: Objects::Includes, ?batch: Objects::Batch?) -> void
    def identify: () -> String
    def fetch: () -> Resource?
    def look_up: () -> Resource?
    def client!: () -> Objects::_Client
    def resolve: (singleton(Resource) klass, untyped id) -> Resource?
    def cursor: (singleton(Resource) klass, String path, max_results: Integer?, ?min_results: Integer, ?total: Symbol?, ?app_only: bool, ?ids_only: bool, **untyped params) -> Cursor[untyped]
  end

  class Page[R < Resource = Resource]
    MARSHAL_FORMAT: Integer
    YAML_KEYS: Array[String]
    LIST_PARAMETERS: Array[String]

    private def self.meta_of: (Objects::body body) -> Hash[String, untyped]
    private def self.list?: (Hash[String, untyped] body) -> bool

    private
    def state: () -> [Array[R], Hash[String, untyped], Array[Problem]]
    def response_of: (Resource resource) -> Objects::Includes
    def read: (singleton(Resource) klass, Objects::attrs attrs, bool hydrated, Objects::Includes includes) -> R
    def resource_states: (Array[Objects::Includes] responses) -> Array[[singleton(Resource), Objects::attrs, bool, Integer]]
    def resources!: (untyped items) -> Array[R]
    def problems!: (untyped problems) -> Array[Problem]
  end

  class Cursor[R < Resource = Resource]
    DEFAULT_TOKEN_PARAM: String
    SERIALIZATION_MESSAGE: String

    @prefetch: bool
    @app_only: bool
    @ids_only: bool
    @total: (^(?fresh: bool) -> Integer?)?
    @pages: Objects::Pages

    attr_reader path: String
    attr_reader params: Objects::query

    private def self.build: [R < Resource] (singleton(Resource) resource_class, String path, client: Objects::_Client, ?params: Objects::params, ?prefetch: bool, ?token_param: String, ?min_results: Integer, ?app_only: bool, ?total: (^(?fresh: bool) -> Integer?)?, ?ids_only: bool) -> Cursor[R]

    private
    attr_reader min_results: Integer
    attr_reader token_param: String
    def setup: (singleton(Resource) resource_class, String path, client: Objects::_Client, params: Objects::params, prefetch: bool, token_param: String, min_results: Integer, app_only: bool, total: (^(?fresh: bool) -> Integer?)?, ids_only: bool) -> void
    def ids_only?: () -> bool
    def app_only?: () -> bool
    def fresh_total: () -> (^(?fresh: bool) -> Integer?)?
    def own_params: () -> Objects::params
    def id_only_params: () -> Objects::params
  end

  class Media < Resource
    extend Objects::BatchFinders

    private def self.id_type: () -> Symbol
    private def self.id_key: () -> String
    private def self.includes_key: () -> String
    private def self.endpoint: () -> String
    private def self.key_of: (untyped media) -> untyped
    private def self.from_id_in_batch: (untyped media, client: Objects::_Client?, ?batch: Objects::Batch?) -> Media
                             | ...
    private def self.batch_key: () -> Symbol
    private def self.fields_key: () -> String
  end

