  class Community < Resource
    MAX_RESULTS: Integer
    extend Objects::Finders

    private def self.endpoint: () -> String
    private def self.fields_key: () -> String
  end

  class List < Resource
    MAX_RESULTS: Integer
    extend Objects::Finders

    private def self.endpoint: () -> String
    private def self.fields_key: () -> String
    private def self.resource_from_response: (Objects::body body, client: Objects::_Client?, ?hydrated: bool) -> List?

    private
    def fewer_memberships?: (Objects::id user) -> bool
    def listed_count_of: (Objects::id user) -> Integer?
  end

  class DirectMessage < Resource
    MAX_RESULTS: Integer
    extend Objects::Finders
    extend Objects::DirectMessageConversations

    private def self.endpoint: () -> String
    private def self.fields_key: () -> String
  end

  class Space < Resource
    MAX_RESULTS: Integer
    extend Objects::BatchFinders

    private def self.id_type: () -> Symbol
    private def self.endpoint: () -> String
    private def self.client_for: (Objects::_Client client) -> Objects::_Client
    private def self.fields_key: () -> String
  end
