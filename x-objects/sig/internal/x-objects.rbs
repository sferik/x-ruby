# The internals of x-objects: the modules, classes, constants, and methods the code keeps private, which Steep type
# checks it against, but which the gem does not ship, since the gemspec packages sig/*.rbs alone. Code that depends
# on x-objects is checked against sig/x-objects.rbs, which declares its public interface, so that it cannot refer to
# what the code hides, and these can change within 1.x.
#
# The modules the resource classes and X::Objects::API are built of are declared here with the methods they give,
# which sig/x-objects.rbs declares on the classes and on API themselves, so that how those methods are grouped can
# change within 1.x.
module X
  module Objects
    type key = Array[String]

    # What Marshal writes of the response some resources came from: the objects it included that they refer to, the
    # problems about them, and the query of the request
    type included = [Hash[String, Array[attrs]], Array[Problem], Hash[String, untyped]?]

    # What a resource that publishes the number of a collection answers, which Resource does
    interface _Counted
      def refresh: () -> Resource?
      def hydrate: () -> Resource?
    end

    module PublishedCount : _Counted
      private
      def counter: (Symbol? total) -> (^(?fresh: bool) -> Integer?)?
    end

    # Serialization of what an API response held, by its attributes alone
    module ValueEquality : _Attributed
      def ==: (untyped other) -> bool
      def eql?: (untyped other) -> bool
      def hash: () -> Integer
    end

    module ValueMarshalling : _Attributed
      MARSHAL_FORMAT: Integer
      YAML_KEYS: Array[String]

      def marshal_dump: () -> [Integer, Hash[String, untyped]]
      def marshal_load: ([Integer, Hash[String, untyped]] state) -> void
      def encode_with: (untyped coder) -> void
      def init_with: (untyped coder) -> void

      private
      def restore: (Hash[String, untyped] attrs) -> void
    end

    module Serialization : _Attributed
      def as_json: (*untyped) -> Hash[String, untyped]
      def to_json: (?JSON::State? state) -> String
    end

    # A resource, whose state Marshal writes and reads
    interface _Marshalled
      def attrs: () -> attrs
      def hydrated?: () -> bool
      def class: () -> singleton(Resource)
    end

    module Marshalling : _Marshalled
      MARSHAL_FORMAT: Integer
      YAML_KEYS: Array[String]

      def marshal_dump: () -> [Integer, attrs, bool, Hash[String, Array[attrs]], Array[Problem], Hash[String, untyped]?]
      def marshal_load: ([Integer, attrs, bool, Hash[String, Array[attrs]], Array[Problem], Hash[String, untyped]?] state) -> void
      def encode_with: (untyped coder) -> void
      def init_with: (untyped coder) -> void
    end

    # Anything the object layer built from an API response, which holds its attributes
    interface _Attributed
      def attrs: () -> Hash[String, untyped]
    end

    module Utils
      extend Utils

      JSON_CLASSES: Hash[Symbol, singleton(Array) | singleton(Hash)]
      NUMERIC_ID: Regexp
      ID_PATTERNS: Hash[Symbol, Regexp]
      ID_DESCRIPTIONS: Hash[Symbol, String]
      USERNAME: Regexp
      FOREIGN_RESOURCE: String

      def deep_freeze: (untyped value) -> untyped
      def count!: (untyped count) -> Integer
      def attributes!: (untyped attrs) -> Hash[untyped, untyped]
      def path: (String base, params params) -> String
      def query: (params params) -> query
      def query_value: (untyped value) -> untyped
      def merge_params: (params defaults, params params) -> query
      def id_of: (untyped value, Class klass) -> String
      def id_from: (untyped value, Class klass) -> String
      def not_an_identifier: (untyped value, Class klass) -> bot
      def username: (untyped value) -> String
      def username!: (untyped value) -> String
      def integer: (String | Integer | nil value) -> Integer?
      def authenticated_user_id: (untyped client) -> Integer?
      def app_client: (untyped client) -> untyped
      def space_client: (untyped client) -> untyped
      def remembered_user_id: (untyped client) -> Integer?
      def remember_user_id: (untyped client, Integer id) -> void
      def authenticator_of: (untyped client) -> untyped
      def id?: (untyped value) -> bool
      def time: (String? value) -> Time?
      def read: [T] (String name, untyped value) { (untyped value) -> T } -> T
      def deconstruct: (untyped value, Array[Symbol]? keys, Array[Symbol] names, ?Array[Symbol] aliases) -> Hash[Symbol, untyped]
    end

    module MediaIds
      extend MediaIds

      MEDIA_KEY: Regexp
      MEDIA_ID: Regexp
      NOT_MEDIA: String

      def media_ids_of: (untyped media_ids) -> Array[String]
      def media_id_of: (untyped value) -> String
      def media_key_id: (untyped media) -> String
    end

    module Shape
      extend Shape

      def dig: (String name, untyped value, Array[String] path) -> untyped
      def dig_first: (String name, untyped value, Array[Array[String]] paths) -> untyped
      def read_object: (String name, untyped value) -> Hash[untyped, untyped]?
      def objects: (String name, untyped value) -> Array[Hash[String, untyped]]
      def object: (untyped value) -> Hash[untyped, untyped]?
      def object!: (untyped value) -> Hash[untyped, untyped]
      def list: (untyped value) -> Array[untyped]?
    end

    module Parallel
      extend Parallel

      def map: [T, U] (Enumerable[T] items, concurrency: Integer) { (T) -> U } -> Array[U]
      private def drain: (Thread::Queue queue, Array[Thread] threads) -> void
      private def worker: [T, U] (Thread::Queue queue, Thread::Queue errors, Array[T] items, Array[U?] results) { (T) -> U } -> Thread
    end

    class Pages
      REPEATED_TOKEN: String

      @cursor: Cursor[untyped]
      @monitor: Monitor
      @pages: Array[Page[untyped]?]
      @prefetching: Set[Integer]

      def initialize: (Cursor[untyped] cursor) -> void
      def at: (Integer index) -> Page[untyped]?
      def read: (Integer count) -> Array[Resource]

      private
      def fetched: () -> Array[Page[untyped]]
      def next_page: (Integer wanted) -> Page[untyped]?
      def cached: (Integer index) -> Page[untyped]?
      def fetch: (Integer index, ?Integer? wanted) -> Page[untyped]?
      def requester: () -> _Client
      def resources_from: (body body) -> Array[Resource]
      def stubs_from: (Array[Resource] resources) -> Array[Resource]
      def id_only?: () -> bool
      def params_for: (Integer index) -> query?
      def next_token: (Integer index) -> String?
      def earlier_tokens: (Array[Page[untyped]] pages, Integer index) -> Array[String]
      def sized: (query params, Integer wanted) -> query
      def prefetch: (Integer index) -> Thread?
      def claim: (Integer index) -> bool
      def let_go: (Integer index) -> void
    end

    class Batch
      @klass: BatchFinders
      @ids: Array[untyped]
      @client: _Client
      @memo: Memo

      def initialize: (BatchFinders klass, Array[untyped] ids, client: _Client) -> void
      def fetch: (untyped id) -> Resource?

      private
      def resources: () -> Hash[untyped, Resource]
    end

    class Memo
      UNSET: Object

      @monitor: Monitor
      @value: untyped

      def initialize: () -> void
      def fetch: () { () -> untyped } -> untyped
      def stored?: () -> bool
      def store: (untyped value) -> untyped
    end

    class Includes
      TWEET_KEYS: Hash[String, String]

      @data: Hash[String?, untyped]
      @monitor: Monitor
      @index: Hash[String?, Hash[untyped, attrs]]
      @resources: Hash[[singleton(Resource), untyped], Resource]

      @problems: Array[Problem]
      @query: Hash[String, untyped]?

      attr_reader problems: Array[Problem]

      def initialize: (?Hash[untyped, untyped]? data, ?problems: Array[Problem], ?query: Hash[String, untyped]?) -> void
      def resolve: (singleton(Resource) klass, untyped id, client: _Client? client) -> Resource
      def problems_about: (Array[untyped] ids) -> Array[Problem]
      def state_of: (Array[Resource] resources) -> Objects::included
      def hydrated_as_read?: (singleton(Resource) klass, bool hydrated) -> bool

      private
      def keep: (Hash[String, Array[attrs]] kept, Array[untyped] ids) -> Array[[singleton(Resource), attrs]]
      def referenced_by: (singleton(Resource) klass, attrs attrs) -> Array[untyped]
      def named: (singleton(Resource) klass, String key, Array[untyped] ids) -> Array[attrs]
      def collections: () -> Array[[singleton(Resource), String]]
      def entries_of: (singleton(Resource) klass) -> Array[attrs]
      def build: (singleton(Resource) klass, untyped id, _Client? client) -> Resource
      def fully_requested?: (singleton(Resource) klass) -> bool
      def about?: (Problem problem, Array[String] ids) -> bool
      def index: (singleton(Resource) klass) -> Hash[untyped, attrs]
    end

    module AbstractClass : Class
      private
      def inherited: (Class subclass) -> void
    end

    module Attributes : Class
      EMPTY_LIST: Array[untyped]
      FLAGS: Array[bool?]
      CONVERTERS: Hash[Symbol, ^(untyped) -> untyped]

      @attribute_names: Array[Symbol]?
      @attribute_aliases: Array[Symbol]?
      @reference_keys: Array[key]?

      private
      def attribute_names: () -> Array[Symbol]
      def attribute_aliases: () -> Array[Symbol]
      def reference_keys: () -> Array[key]
      def referenced_ids: (Hash[String, untyped] attrs) -> Array[untyped]
      def ids_at: (Hash[String, untyped] attrs, key path) -> Array[untyped]
      def attribute_alias: (Symbol name, Symbol original) -> void
      def attribute: (Symbol name, ?Symbol type, ?key: key, ?tweet_key: key?) -> void
      def reference: (Symbol name, Symbol klass_name, key: key, ?tweet_key: key?) -> void
      def references: (Symbol name, Symbol klass_name, key: key) -> void
      def key_path: (untyped key) -> key
      def key_paths: (untyped key, untyped tweet_key) -> Array[key]
    end

    interface _Identifiable
      def id: () -> (Integer | String)
      def class: () -> singleton(Resource)
    end

    module Identity : _Identifiable
      def ==: (untyped other) -> bool
      def eql?: (untyped other) -> bool
      def hash: () -> Integer
      def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, untyped]
    end

    interface _Following
      def following: (**untyped params) -> Cursor[User]
    end

    module Relationships : Resource, _Following
      def follow: (id user) -> bool
      def unfollow: (id user) -> bool
      def block: (id user) -> bool
      def unblock: (id user) -> bool
      def mute: (id user) -> bool
      def unmute: (id user) -> bool
      def like: (id post) -> bool
      def unlike: (id post) -> bool
      def repost: (id post) -> bool
      def retweet: (id post) -> bool
      def unrepost: (id post) -> bool
      def unretweet: (id post) -> bool
      def bookmark: (id post) -> bool
      def unbookmark: (id post) -> bool
      def follow_list: (id list) -> bool
      def unfollow_list: (id list) -> bool
      def pin_list: (id list) -> bool
      def unpin_list: (id list) -> bool
      def follows?: (id user) -> bool

      private
      def authenticated_user_id: () -> Integer?
      def connection_status_of: (id user) -> Array[String]
      def relate: (String relation, String key, String target, *String states) -> bool
      def unrelate: (String relation, String target, String state) -> bool
    end

    interface _FinderHost
      def default_params: () -> Hash[String, Array[String]]
    end

    module UserFinders : Class, BatchFinders
      include BatchFinders

      def find: (id id_or_username, client: _Client, **untyped params) ?{ (Problem problem) -> void } -> Resource?
      def find!: (id id_or_username, client: _Client, **untyped params) -> Resource
      def find_all: (Array[id] ids_or_usernames, client: _Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[User]
      def find_all_by_id: (Array[id] ids, client: _Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[User]
      def find_by_id: (id id, client: _Client, **untyped params) ?{ (Problem problem) -> void } -> User?
      def find_by_id!: (id id, client: _Client, **untyped params) -> User
      def find_all_by_username: (Array[String] usernames, client: _Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[User]
      def find_by_username: (String username, client: _Client, **untyped params) ?{ (Problem problem) -> void } -> User?
      def find_by_username!: (String username, client: _Client, **untyped params) -> User
      def current: (client: _Client, **untyped params) ?{ (Problem problem) -> void } -> User?
      def current!: (client: _Client, **untyped params) -> User

      private
      def in_order: (Array[User] users, Array[id] ids_or_usernames) -> Array[User]
      def key_of: (untyped value) -> String
      def normalize: (untyped username) -> String
    end

    module Finders : Class, _FinderHost
      def find: (id id, client: _Client, **untyped params) ?{ (Problem problem) -> void } -> Resource?
      def find!: (id id, client: _Client, **untyped params) -> Resource
      private
      def lookup: (String path, client: _Client, **untyped params) ?{ (Problem problem) -> void } -> Resource?
      def lookup_all: (String path, client: _Client, **untyped params) ?{ (Problem problem) -> void } -> Array[Resource]
      def client_for: (_Client client) -> _Client
      def get: (String path, client: _Client, query: Hash[String, untyped]) -> body
      def reporting: (body body) ?{ (Problem problem) -> void } -> body
      def resourceless?: (body body) -> bool

      # The private class methods of the resource class that extends it, which it reads
      def endpoint!: () -> String
      def id_key: () -> String
      def fully_requested_by?: (Hash[String, untyped] query) -> bool
      def resource_built_from: (body body, client: _Client?, hydrated: bool, query: Hash[String, untyped]?) -> Resource?
      def collection_built_from: (body body, client: _Client?, hydrated: bool, query: Hash[String, untyped]?) -> Array[Resource]
    end

    module BatchFinders : Class, _FinderHost
      include Finders

      MAX_BATCH_SIZE: Integer
      DEFAULT_CONCURRENCY: Integer
      INVALID_CONCURRENCY: String
      FOREIGN_RESOURCE: String

      def hydrate_all: (Array[Resource?] resources, client: _Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Resource]
      def find_all: (Array[id] ids, client: _Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Resource]
      private
      def replacer: (Array[Resource] found, Hash[Symbol, untyped] params) -> ^(Resource) -> Resource?
      def lookup_in_batches: (String path, Symbol key, Array[String] values, client: _Client, concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Resource]
      def in_order_of: (Array[Resource] resources, Array[String] ids) -> Array[Resource]
      def settled?: (Resource resource) -> bool
      def validate_concurrency!: (Integer concurrency) -> void
      def validate_class!: (Array[Resource] resources) -> void

      # The private class methods of the resource class that extends it, which it reads
      def id_type: () -> Symbol
      def batch_key: () -> Symbol
    end

    module PostWrites : _ResourceClass[Post]
      def create: (?String? text, client: _Client, ?reply_to: id?, ?quote: id?, ?media_ids: untyped, ?community: id?, **untyped params) -> Post?
      def delete: (id post, client: _Client) -> bool
      def hide_reply: (id post, client: _Client) -> bool
      def unhide_reply: (id post, client: _Client) -> bool

      private
      # The private class method of Post that extends it, which it reads
      def resource_from_response: (body body, client: _Client?, ?hydrated: bool) -> Post?
      def change_visibility: (id post, bool hidden, client: _Client) -> bool?
      def referenced: (Hash[Symbol, untyped] params, reply_to: id?, quote: id?, media_ids: untyped, community: id?) -> Hash[Symbol, untyped]
      def merged: (Hash[Symbol, untyped] params, Symbol key, **untyped field) -> Hash[Symbol, untyped]
    end

    module DirectMessageConversations
      MAX_RESULTS: Integer
      CONVERSATION_ID: Regexp

      def create_group: (Array[id] users, ?String? text, client: _Client, ?media_ids: untyped, **untyped params) -> DirectMessage?
      def create_in: (DirectMessage | String | Integer conversation, ?String? text, client: _Client, ?media_ids: untyped, **untyped params) -> DirectMessage?
      def `in`: (DirectMessage | String | Integer conversation, client: _Client, **untyped params) -> Cursor[DirectMessage]

      private
      # The private class method of DirectMessage that extends it, which it reads
      def resource_from_response: (body body, client: _Client?, ?hydrated: bool) -> DirectMessage?
      def conversation_id_of: (DirectMessage | String | Integer conversation) -> String
      def message: (String? text, Hash[Symbol, untyped] params, untyped media_ids) -> Hash[Symbol, untyped]
      def sent: (body body, client: _Client) -> DirectMessage?
    end

    module PostCounts
      RECENT_ENDPOINT: String
      ALL_ENDPOINT: String
      DEFAULT_GRANULARITY: String

      def count: (String query, client: _Client, **untyped params) -> Integer
      def count_all: (String query, client: _Client, **untyped params) -> Integer
      def count_by_period: (String query, client: _Client, **untyped params) -> Hash[Range[Time], Integer]
      def count_all_by_period: (String query, client: _Client, **untyped params) -> Hash[Range[Time], Integer]

      private
      def pages: (String path, String query, client: _Client, **untyped params) -> Array[Hash[String, untyped]]
      def next_token: (Array[Hash[String, untyped]] bodies, untyped given) -> untyped
      def total: (Array[Hash[String, untyped]] bodies) -> Integer
      def page_total: (Integer | String | nil value) -> Integer
      def periods: (Array[Hash[String, untyped]] bodies) -> Hash[Range[Time], Integer]
      def period: (Hash[String, untyped] entry) -> [Range[Time], Integer]
    end

    module PostSearch : _ResourceClass[Post]
      MAX_RESULTS: Integer
      MAX_ARCHIVE_RESULTS: Integer
      def search: (String query, client: _Client, **untyped params) -> Cursor[Post]
      def search_all: (String query, client: _Client, **untyped params) -> Cursor[Post]
      def reposts_of_me: (client: _Client, **untyped params) -> Cursor[Post]
      def retweets_of_me: (client: _Client, **untyped params) -> Cursor[Post]

      private
      def context_annotations?: (Hash[Symbol, untyped] params) -> bool
    end

