    FIELDS: Array[String]

    attr_reader attrs: Hash[String, untyped]

    def self.all: (client: Objects::_Client, **untyped params) -> Array[PersonalizedTrend]
    def initialize: (Hash[String, untyped] attrs) -> void
    def to_h: () -> Hash[String, untyped]
    def name: () -> String?
    def category: () -> String?
    def post_count_text: () -> String?
    def trending_since: () -> String?
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, untyped]
    def as_json: (*untyped) -> Hash[String, untyped]
    def to_json: (?JSON::State? state) -> String
    def marshal_dump: () -> untyped
    def marshal_load: (untyped state) -> void
  end

  class PostUsage
    FIELDS: Array[String]

    attr_reader attrs: Hash[String, untyped]

    def self.current: (client: Objects::_Client, **untyped params) -> PostUsage
    def initialize: (Hash[String, untyped] attrs) -> void
    def to_h: () -> Hash[String, untyped]
    def project_id: () -> Integer?
    def project_usage: () -> Integer?
    def project_cap: () -> Integer?
    def cap_reset_day: () -> Integer?
    def daily: () -> Hash[Time, Integer]
    def daily_by_app: () -> Hash[Integer?, Hash[Time, Integer]]
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, untyped]
    def as_json: (*untyped) -> Hash[String, untyped]
    def to_json: (?JSON::State? state) -> String
    def marshal_dump: () -> untyped
    def marshal_load: (untyped state) -> void
  end

  module Objects
    VERSION: String

    def self.gem_version: () -> Gem::Version

    type attrs = Hash[String, untyped]
    type params = Hash[String | Symbol, untyped]
    type query = Hash[String, untyped]
    type body = Hash[String, untyped]?
    type id = String | Integer | Resource

    # What an upload returned, holding the identifier of the media: a Hash, or the uploaded media of x-uploader
    interface _UploadedMedia
      def fetch: (String key) -> untyped
    end

    # Media that holds a media key, such as the uploaded media of x-uploader, which media is looked up by
    interface _MediaKeyHolder
      def media_key: () -> String?
    end

    # What the object layer asks to make its requests: X::Client, or any other client that answers these four
    # methods, since x-objects makes no request of its own. The endpoint carries the query, which the object layer
    # builds, and array_class and object_class say what the response is parsed into, which is plain hashes and
    # arrays wherever the object layer reads a response itself. A client that also answers app_only, authenticator,
    # or current_user_id is asked for them where they save a request: without app_only, an endpoint that refuses
    # the OAuth 1.0a of a user is requested with the client itself; without authenticator, the authenticated user
    # is looked up rather than read from the access token that names them; and without current_user_id, a check of
    # whether one user follows another scans rather than reads connection_status. A release within 1.x may pass any
    # other keyword X::Client takes for the same method, such as params: or headers:, so each takes the rest of its
    # keywords untyped.
    interface _Client
      def get: (String endpoint, ?array_class: Class, ?object_class: untyped, **untyped) -> untyped
      def post: (String endpoint, ?(String | Hash[untyped, untyped])? body, ?array_class: Class, ?object_class: untyped, **untyped) -> untyped
      def put: (String endpoint, ?(String | Hash[untyped, untyped])? body, ?array_class: Class, ?object_class: untyped, **untyped) -> untyped
      def delete: (String endpoint, ?array_class: Class, ?object_class: untyped, **untyped) -> untyped
    end

    # The class side of every concrete resource class, typed with that class
    interface _ResourceClass[R < Resource]
      def from_id: (id id, ?client: _Client?) -> R
      def from_response: (body body, client: _Client?, ?hydrated: bool, **untyped) -> (R | Page[R])?
    end

    # The class-side lookups of a concrete resource class the API looks up by identifier, typed with that class
    interface _Lookup[R]
      def find: (id id, client: _Client, **untyped params) ?{ (Problem problem) -> void } -> R?
      def find!: (id id, client: _Client, **untyped params) -> R
    end

    # The class-side lookups of a concrete resource class the API looks up many at a time, typed with that class
    interface _BatchLookup[R]
      def find_all: (Array[id] ids, client: _Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[R]
      def hydrate_all: (Array[R?] resources, client: _Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[R]
    end

    # The instance-side hydration of a concrete resource class, typed with that class
    interface _Hydration[R]
      def hydrate: () -> R?
      def refresh: () -> R?
    end

    module API : _Client
      def find_user: (id | String id_or_username, **untyped params) ?{ (Problem problem) -> void } -> User?
      def find_user!: (id | String id_or_username, **untyped params) -> User
      def find_user_by_username: (String username, **untyped params) ?{ (Problem problem) -> void } -> User?
      def find_user_by_username!: (String username, **untyped params) -> User
      def find_all_users: (Array[id | String] ids_or_usernames, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[User]
      def find_all_users_by_username: (Array[String] usernames, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[User]
      def find_user_by_id: (id id, **untyped params) ?{ (Problem problem) -> void } -> User?
      def find_user_by_id!: (id id, **untyped params) -> User
      def find_all_users_by_id: (Array[id] ids, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[User]
      def current_user: (**untyped params) ?{ (Problem problem) -> void } -> User?
      def current_user!: (**untyped params) -> User
      def current_user_id: () -> Integer
      def search_users: (String query, **untyped params) -> Cursor[User]
      def find_post: (id id, **untyped params) ?{ (Problem problem) -> void } -> Post?
      def find_tweet: (id id, **untyped params) ?{ (Problem problem) -> void } -> Post?
      def find_post!: (id id, **untyped params) -> Post
      def find_tweet!: (id id, **untyped params) -> Post
      def find_all_posts: (Array[id] ids, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Post]
      def find_all_tweets: (Array[id] ids, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Post]
      def search_posts: (String query, **untyped params) -> Cursor[Post]
      def search_tweets: (String query, **untyped params) -> Cursor[Post]
      def search_all_posts: (String query, **untyped params) -> Cursor[Post]
      def reposts_of_me: (**untyped params) -> Cursor[Post]
      def retweets_of_me: (**untyped params) -> Cursor[Post]
      def search_all_tweets: (String query, **untyped params) -> Cursor[Post]
      def post_usage: (**untyped params) -> PostUsage
      def count_posts: (String query, **untyped params) -> Integer
      def count_tweets: (String query, **untyped params) -> Integer
      def count_all_posts: (String query, **untyped params) -> Integer
      def count_all_tweets: (String query, **untyped params) -> Integer
      def count_posts_by_period: (String query, **untyped params) -> Hash[Time, Integer]
      def count_tweets_by_period: (String query, **untyped params) -> Hash[Time, Integer]
      def count_all_posts_by_period: (String query, **untyped params) -> Hash[Time, Integer]
      def count_all_tweets_by_period: (String query, **untyped params) -> Hash[Time, Integer]
      def find_list: (id id, **untyped params) ?{ (Problem problem) -> void } -> List?
      def find_list!: (id id, **untyped params) -> List
      def find_space: (id id, **untyped params) ?{ (Problem problem) -> void } -> Space?
      def find_space!: (id id, **untyped params) -> Space
      def find_all_spaces: (Array[id] ids, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Space]
      def search_spaces: (String query, **untyped params) -> Cursor[Space]
      def find_all_spaces_by_creator: (Array[id] users, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Space]
      def find_media: (String | _MediaKeyHolder media_key, **untyped params) ?{ (Problem problem) -> void } -> X::Media?
      def find_all_media: (Array[String | _MediaKeyHolder] media, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[X::Media]
      def find_media!: (String | _MediaKeyHolder media_key, **untyped params) -> X::Media
      def find_community: (id id, **untyped params) ?{ (Problem problem) -> void } -> Community?
      def find_community!: (id id, **untyped params) -> Community
      def search_communities: (String query, **untyped params) -> Cursor[Community]
      def trends: (Integer | String woeid, **untyped params) -> Array[Trend]
      def personalized_trends: (**untyped params) -> Array[PersonalizedTrend]
      def find_direct_message: (id id, **untyped params) ?{ (Problem problem) -> void } -> DirectMessage?
      def find_dm: (id id, **untyped params) ?{ (Problem problem) -> void } -> DirectMessage?
      def find_direct_message!: (id id, **untyped params) -> DirectMessage
      def find_dm!: (id id, **untyped params) -> DirectMessage
      def direct_messages: (**untyped params) -> Cursor[DirectMessage]
      def dms: (**untyped params) -> Cursor[DirectMessage]
      def direct_messages_with: (id user, **untyped params) -> Cursor[DirectMessage]
      def dms_with: (id user, **untyped params) -> Cursor[DirectMessage]
      def direct_messages_in: (DirectMessage | String | Integer conversation, **untyped params) -> Cursor[DirectMessage]
      def dms_in: (DirectMessage | String | Integer conversation, **untyped params) -> Cursor[DirectMessage]
      def create_post: (?String? text, ?reply_to: Objects::id?, ?quote: Objects::id?, ?media_ids: untyped, ?community: Objects::id?, **untyped params) -> Post?
      def create_tweet: (?String? text, ?reply_to: Objects::id?, ?quote: Objects::id?, ?media_ids: untyped, ?community: Objects::id?, **untyped params) -> Post?
