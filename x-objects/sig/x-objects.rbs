    def uri: () -> URI::Generic
    def followers: (**untyped params) -> Cursor[User]
    def following: (**untyped params) -> Cursor[User]
    def blocking: (**untyped params) -> Cursor[User]
    def muting: (**untyped params) -> Cursor[User]
    def affiliates: (**untyped params) -> Cursor[User]
    def posts: (**untyped params) -> Cursor[Post]
