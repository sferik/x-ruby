    def self.find_all_by_id: (Array[Objects::id] ids, client: Objects::_Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[User]
    def self.find_by_username: (String username, client: Objects::_Client, **untyped params) ?{ (Problem problem) -> void } -> User?
