        module Relationships : _Client, _CurrentUser
          def follow: (id user) -> bool
          def unfollow: (id user) -> bool
          def block: (id user) -> bool
          def unblock: (id user) -> bool
          def mute: (id user) -> bool
          def unmute: (id user) -> bool
        end

        module Engagement : _Client, _CurrentUser
          def like: (id post) -> bool
          def unlike: (id post) -> bool
          def repost: (id post) -> bool
          def retweet: (id post) -> bool
          def unrepost: (id post) -> bool
          def unretweet: (id post) -> bool
          def bookmark: (id post) -> bool
          def unbookmark: (id post) -> bool
        end
      end
    end
  end

  class Resource
    extend Objects::Attributes
    extend Objects::Finders
    include Objects::PublishedCount
    include Objects::Identity
    include Objects::Serialization

    attr_reader attrs: Objects::attrs
    attr_reader client: Objects::_Client?
    private attr_reader includes: Objects::Includes

    @hydrated: bool
    @batch: Objects::Batch?
    @memo: Objects::Memo

    def self.endpoint: () -> String?
    def self.id_key: () -> String
    def self.id_type: () -> Symbol
    def self.includes_key: () -> String?
    def self.fields_key: () -> String?
    def self.fully_requested_by?: (Hash[String, untyped] query) -> bool
    def self.default_params: () -> Hash[String, Array[String]]
    def self.hydratable?: () -> bool
    def self.batchable?: () -> bool
    def self.batch_key: () -> Symbol
    def self.endpoint!: () -> String
    def self.from_id: (Objects::id id, ?client: Objects::_Client?, ?batch: Objects::Batch?) -> Resource
    def self.from_response: (Objects::body body, client: Objects::_Client?, ?hydrated: bool) -> (Resource | Array[Resource])?
    def self.resource_from_response: (Objects::body body, client: Objects::_Client?, ?hydrated: bool) -> Resource?
    def self.collection_from_response: (Objects::body body, client: Objects::_Client?, ?hydrated: bool) -> Array[Resource]

    def initialize: (Hash[untyped, untyped] attrs, ?client: Objects::_Client?, ?includes: Objects::Includes, ?hydrated: bool, ?batch: Objects::Batch?) -> void
    def id: () -> (Integer | String)
    def to_h: () -> Objects::attrs
    def problems: () -> Array[Problem]
    def hydrated?: () -> bool
    def stub?: () -> bool
    def hydrate: () -> Resource?
    def refresh: () -> Resource?
    def marshal_dump: () -> Objects::attrs
    def marshal_load: (Objects::attrs attrs) -> void
    def inspect: () -> String

    private
    def hydrated_with: (Resource? resource) -> Resource?
    def hydration_stored?: () -> bool
    def identify: () -> String
    def fetch: () -> Resource?
    def look_up: () -> Resource?
    def client!: () -> Objects::_Client
    def resolve: (singleton(Resource) klass, untyped id) -> Resource?
    def cursor: (singleton(Resource) klass, String path, max_results: Integer?, ?min_results: Integer, ?total: Symbol?, ?app_only: bool, **untyped params) -> Cursor[untyped]
  end

  class Page[R < Resource = Resource]
    extend Forwardable
    include Enumerable[R]

    attr_reader items: Array[R]
    attr_reader meta: Hash[String, untyped]
    attr_reader problems: Array[Problem]

    def initialize: (Array[R] items, Hash[untyped, untyped] meta, ?problems: Array[Problem]) -> void
    def each: () { (R) -> void } -> Array[R]
            | () -> Enumerator[R, Array[R]]
    def next_token: () -> String?
    def result_count: () -> Integer?
    def as_json: (*untyped) -> Array[R]
    def to_json: (?JSON::State? state) -> String
  end

  class Cursor[R < Resource = Resource]
    include Enumerable[R]

    DEFAULT_TOKEN_PARAM: String

    attr_reader resource_class: singleton(Resource)
    attr_reader client: Objects::_Client
    attr_reader path: String
    attr_reader params: Objects::query
    attr_reader token_param: String
    attr_reader min_results: Integer

    @prefetch: bool
    @app_only: bool
    @total: (^(?fresh: bool) -> Integer?)?
    @pages: Objects::Pages

    def initialize: (singleton(Resource) resource_class, String path, client: Objects::_Client, ?params: Objects::params, ?prefetch: bool, ?token_param: String, ?min_results: Integer, ?app_only: bool, ?total: (^(?fresh: bool) -> Integer?)?) -> void
    def prefetch?: () -> bool
    def app_only?: () -> bool
    def each: () { (R) -> void } -> self
            | () -> Enumerator[R, self]
    def each_page: () { (Page[R]) -> void } -> self
                 | () -> Enumerator[Page[R], self]
    def page: (Integer index) -> Page[R]?
    def refresh: () -> Cursor[R]
    def prefetch: () -> Cursor[R]
    def stubs: () -> Cursor[R]
    def first: () -> R?
             | (Integer count) -> Array[R]
    def take: (Integer count) -> Array[R]
    def ids: () -> Array[Integer | String]
    def any?: (*untyped pattern) ?{ (R) -> boolish } -> bool
    def none?: (*untyped pattern) ?{ (R) -> boolish } -> bool
    def empty?: () -> bool
    def one?: (*untyped pattern) ?{ (R) -> boolish } -> bool
    def published_count: () -> Integer?
    def as_json: (*untyped) -> Array[R]
    def to_json: (?JSON::State? state) -> String
    def inspect: () -> String

    private
    def fresh_total: () -> (^(?fresh: bool) -> Integer?)?
    def own_params: () -> Objects::params
    def id_only_params: () -> Objects::params
  end

