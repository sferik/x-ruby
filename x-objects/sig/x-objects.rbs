      def unbookmark: (id post) -> bool
    end
  end

  class Resource
    attr_reader attrs: Objects::attrs
    attr_reader client: Objects::_Client?

    def self.default_params: () -> Hash[String, Array[String]]
    def self.from_id: (Objects::id id, ?client: Objects::_Client?) -> Resource
    def self.from_response: (Objects::body body, client: Objects::_Client?, ?hydrated: bool, **untyped) -> (Resource | Page[Resource])?

    def initialize: (Hash[untyped, untyped] attrs, ?client: Objects::_Client?, ?hydrated: bool) -> void
    def id: () -> (Integer | String)
    def to_h: () -> Objects::attrs
    def problems: () -> Array[Problem]
    def hydrated?: () -> bool
    def stub?: () -> bool
    def hydrate: () -> Resource?
    def refresh: () -> Resource?
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, untyped]
    def as_json: (*untyped) -> Hash[String, untyped]
    def to_json: (?JSON::State? state) -> String
    def marshal_dump: () -> untyped
    def marshal_load: (untyped state) -> void
    def encode_with: (untyped coder) -> void
    def init_with: (untyped coder) -> void
    def inspect: () -> String
  end

  class Page[R < Resource = Resource]
    include Enumerable[R]

    attr_reader items: Array[R]
    attr_reader meta: Hash[String, untyped]
    attr_reader problems: Array[Problem]

    def initialize: (Array[R] items, Hash[untyped, untyped] meta, ?problems: Array[Problem]) -> void
    def each: () { (R) -> void } -> self
            | () -> Enumerator[R, self]
    def to_a: () -> Array[R]
    def entries: () -> Array[R]
    def size: () -> Integer
    def length: () -> Integer
    def empty?: () -> bool
    def []: (Integer index) -> R?
          | (Integer start, Integer length) -> Array[R]?
          | (Range[Integer?] range) -> Array[R]?
    def last: () -> R?
            | (Integer count) -> Array[R]
    def next_token: () -> String?
    def result_count: () -> Integer?
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def as_json: (*untyped) -> Hash[String, untyped]
    def to_json: (?JSON::State? state) -> String
    def marshal_dump: () -> untyped
    def marshal_load: (untyped state) -> void
    def encode_with: (untyped coder) -> void
    def init_with: (untyped coder) -> void
  end

  class Cursor[R < Resource = Resource]
    include Enumerable[R]

    attr_reader resource_class: singleton(Resource)
    attr_reader client: Objects::_Client

    def prefetch?: () -> bool
    def each: () { (R) -> void } -> self
            | () -> Enumerator[R, self]
    def each_page: () { (Page[R]) -> void } -> self
                 | () -> Enumerator[Page[R], self]
    def page: (Integer index) -> Page[R]?
    def refresh: () -> Cursor[R]
    def prefetch: () -> Cursor[R]
    def stubs: () -> Cursor[R]
    def first: () -> R?
             | (Integer count) -> Array[R]
    def take: (Integer count) -> Array[R]
    def to_a: () -> Array[R]
    def entries: () -> Array[R]
    def ids: () -> Array[Integer | String]
    def any?: (*untyped pattern) ?{ (R) -> boolish } -> bool
    def none?: (*untyped pattern) ?{ (R) -> boolish } -> bool
    def empty?: () -> bool
    def one?: (*untyped pattern) ?{ (R) -> boolish } -> bool
    def published_count: () -> Integer?
    def as_json: (*untyped) -> bot
    def to_json: (?JSON::State? state) -> bot
    def marshal_dump: () -> bot
    def encode_with: (untyped coder) -> bot
    def inspect: () -> String
  end

  # Media is looked up by its media key, or by what holds one, and not by the numeric identifier an upload returns, so
  # it declares its lookups rather than take those of the resources looked up by any identifier
  class Media < Resource
    include Objects::_Hydration[Media]
    FIELDS: Array[String]

    def id: () -> String

    def self.find: (String | Objects::_MediaKeyHolder media, client: Objects::_Client, **untyped params) ?{ (Problem problem) -> void } -> Media?
    def self.find_all: (Array[String | Objects::_MediaKeyHolder] media, client: Objects::_Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Media]
    def self.find!: (String | Objects::_MediaKeyHolder media, client: Objects::_Client, **untyped params) -> Media
    def self.from_id: (String | Objects::_MediaKeyHolder media, ?client: Objects::_Client?) -> Media
    def self.from_response: (Objects::body body, client: Objects::_Client?, ?hydrated: bool, **untyped) -> (Media | Page[Media])?
    def self.hydrate_all: (Array[Media?] resources, client: Objects::_Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[Media]
    def self.default_params: () -> Hash[String, Array[String]]
    def media_key: () -> String
    def media_id: () -> Integer
    def type: () -> String?
    def url: () -> String?
    def preview_image_url: () -> String?
    def alt_text: () -> String?
    def duration_ms: () -> Integer?
    def height: () -> Integer?
    def width: () -> Integer?
    def variants: () -> Array[Hash[String, untyped]]
    def public_metrics: () -> Hash[String, untyped]?
    def view_count: () -> Integer?
  end

  class BookmarkFolder < Resource
    extend Objects::_ResourceClass[BookmarkFolder]
    include Objects::_Hydration[BookmarkFolder]

    def id: () -> Integer

    def name: () -> String?
