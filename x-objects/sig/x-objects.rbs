    def self.find_all_by_username: (Array[String] usernames, client: Objects::_Client, ?concurrency: Integer, **untyped params) ?{ (Problem problem) -> void } -> Array[User]
    def self.current: (client: Objects::_Client, **untyped params) ?{ (Problem problem) -> void } -> User?
    def self.current!: (client: Objects::_Client, **untyped params) -> User
    def self.search: (String query, client: Objects::_Client, **untyped params) -> Cursor[User]

