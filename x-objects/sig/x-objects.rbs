# The public interface of x-objects, as its @api public documentation states it. The modules the resource classes
# and X::Objects::API are built of, such as Finders, Relationships, and Lookups::Users, the helpers of the
# object layer, such as Utils, Pages, and Includes, and the constants, methods, and instance variables the code keeps
# private are declared in sig/internal/x-objects.rbs, which reopens the same modules and classes, so that Steep type
# checks the gem against them, but which the gem does not ship. The public methods those modules give a resource
# class, or a client that includes API, are declared here on the class, and on API.
module X
  module Objects
    class Error < ::X::Error
    end
  end

  class MissingResource < Objects::Error
    attr_reader problems: Array[Problem]

    def initialize: (?String? message, ?problems: Array[Problem]) -> void
  end

  class UnreadableResponse < Objects::Error
  end

  class InvalidAttribute < UnreadableResponse
  end

  class MissingClient < Objects::Error
  end

  class Trend
    FIELDS: Array[String]

    attr_reader attrs: Hash[String, untyped]

    def self.at: (Integer | String woeid, client: Objects::_Client, **untyped params) -> Array[Trend]
    def initialize: (Hash[String, untyped] attrs) -> void
    def to_h: () -> Hash[String, untyped]
    def name: () -> String?
    def post_count: () -> Integer?
    def tweet_count: () -> Integer?
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
    def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, untyped]
    def as_json: (*untyped) -> Hash[String, untyped]
    def to_json: (?JSON::State? state) -> String
    def marshal_dump: () -> untyped
    def marshal_load: (untyped state) -> void
  end

