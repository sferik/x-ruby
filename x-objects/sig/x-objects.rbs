    def id: () -> Integer

    FIELDS: Array[String]
    EXPANSIONS: Array[String]

    def self.default_params: () -> Hash[String, Array[String]]
    def self.find_by_id: (Objects::id id, client: Objects::_Client, **untyped params) ?{ (Problem problem) -> void } -> User?
