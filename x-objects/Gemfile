source "https://rubygems.org"

# Specify the gem's dependencies in x-objects.gemspec
gemspec

# Use the x-core in this repository rather than a released version
gem "x-core", path: "../x-core"

gem "minitest", ">= 6"
gem "minitest-mock", ">= 5.27"
gem "rake", ">= 13.0.6"
gem "simplecov", ">= 1"
gem "yard", ">= 0.9"
gem "yardstick", ">= 0.9"

# Mutant and Steep run on CRuby alone, so they are left out of the bundle of any other engine, whose job
# runs the tests alone; the mutant, steep, and docs jobs of CI all run on CRuby
platforms :mri do
  gem "mutant-minitest", ">= 0.16"
  gem "steep", ">= 2.0"
end
